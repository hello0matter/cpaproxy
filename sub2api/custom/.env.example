# =============================================================================
# Sub2API 部署参数（示例 / 占位符）
# -----------------------------------------------------------------------------
# 复制成 .env 后再填真实值：
#   cp .env.example .env && chmod 600 .env
#
# .env 已被 .gitignore 忽略，真实的数据库口令、管理员口令不要提交到仓库。
# =============================================================================

# --- 镜像 -------------------------------------------------------------------
SUB2API_IMAGE=weishaw/sub2api:0.2.21
CONTAINER_NAME=sub2api

# --- 对外绑定 ---------------------------------------------------------------
# 只绑本机回环，外部访问走 nginx 反代（需要域名时再配 server_name）
BIND_HOST=127.0.0.1
HOST_PORT=18080
CONTAINER_PORT=8080

# --- 数据目录（宿主机） -----------------------------------------------------
DATA_DIR=/root/cpaproxy/sub2api/data

# --- 时区 -------------------------------------------------------------------
TZ=Asia/Shanghai

# --- 数据库（复用已有的 postgres 容器） -------------------------------------
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=root
DATABASE_PASSWORD=CHANGE_ME
DATABASE_DBNAME=sub2api
DATABASE_SSLMODE=disable
# 现有的 postgres 默认 max_connections=100，且已跑着 new-api，
# 这里刻意压低，避免把连接池吃满
DATABASE_MAX_OPEN_CONNS=20
DATABASE_MAX_IDLE_CONNS=10

# --- Redis（复用已有的 redis 容器，用独立 db 号隔离） -----------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=3

# --- 初始管理员 -------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_AT_LEAST_8_CHARS

# --- 安全 -------------------------------------------------------------------
# 留空则首次启动自动生成并写入容器内 config.yaml（数据卷里持久化）
JWT_SECRET=

# --- 资源限制（宿主机只有 967 MB 内存） ------------------------------------
MEMORY_LIMIT=384m
MEMORY_SWAP=768m

# --- 站点品牌（首次启动后也可在后台「系统设置」里改） ----------------------
SITE_NAME=CPAPROXY

# --- 可选：Google 相关 OAuth（见 PATCHES.md） -------------------------------
# 源码里已移除上游硬编码的公共凭据，只有用到 Gemini CLI 内置客户端 /
# Antigravity 登录时才需要填；不填不影响其它网关功能。
# GEMINI_CLI_OAUTH_CLIENT_ID=
# GEMINI_CLI_OAUTH_CLIENT_SECRET=
# ANTIGRAVITY_OAUTH_CLIENT_ID=
# ANTIGRAVITY_OAUTH_CLIENT_SECRET=
