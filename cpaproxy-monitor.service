[Unit]
Description=CLIProxy chat log monitor (user question / AI output extraction)
Documentation=file:/root/cpaproxy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/cpaproxy
ExecStart=/usr/bin/python3 /root/cpaproxy/cliproxy_monitor.py
Restart=always
RestartSec=10
# 日志走 journald，避免服务自己再写一份日志文件
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8

[Install]
WantedBy=multi-user.target